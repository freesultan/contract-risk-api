# --- Server ---
PORT=3000

# --- RPC (free public endpoints, no signup required) ---
RPC_URL_BASE=https://mainnet.base.org
RPC_URL_ETHEREUM=https://ethereum-rpc.publicnode.com

# --- Payment gating (x402 via PayAI's facilitator, no signup required) ---
# Settlement is peer-to-peer on-chain straight to EVM_ADDRESS — the
# facilitator never custodies funds, so no Stripe/KYC/company account needed.
# Leave ENABLE_PAYMENTS unset/false to run free (usage still logged as evidence).
ENABLE_PAYMENTS=false
EVM_ADDRESS=
PRICE_PER_SCAN=$0.02
X402_NETWORK=eip155:8453

# --- Usage log (evidence for Phase 2 verification) ---
USAGE_LOG_PATH=./usage.log.jsonl

# --- Payer wallet for scripts/pay-and-scan.js (trigger the Bazaar listing) ---
# Only needed to run `npm run pay:scan`. Must hold a little USDC on Base
# (network eip155:8453 — same chain X402_NETWORK above points at). USDC on
# other chains (Polygon, zkSync Era, etc.) is a different asset and can't
# pay this route. Can be the same wallet as EVM_ADDRESS (self-pay: funds
# leave and return to the same address, so net cost is ~$0 — the facilitator
# covers gas, you only need the PRICE_PER_SCAN amount as a balance to sign
# against). Never commit a real key — this file is gitignored, keep it that way.
PAYER_PRIVATE_KEY=
SCAN_API_URL=https://smartcontractrisk.0xhodhod.xyz/v1/scan
