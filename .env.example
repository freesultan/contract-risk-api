# --- Server ---
PORT=3000

# --- RPC (free public endpoints, no signup required) ---
RPC_URL_BASE=https://mainnet.base.org
RPC_URL_ETHEREUM=https://ethereum-rpc.publicnode.com

# --- Payment gating (Nevermined x402 facilitator) ---
# Leave ENABLE_PAYMENTS unset/false to run free (usage still logged as evidence).
# Flipping this on requires an approval-gated step: creating a Nevermined
# account (nevermined.app), a payment plan in their dashboard, and a
# receiving wallet configured there. Get a "sandbox:" key first and test
# with zero real money before switching to a "live:" key.
ENABLE_PAYMENTS=false
NVM_API_KEY=
NVM_PLAN_ID=
CREDITS_PER_SCAN=1

# --- Usage log (evidence for Phase 2 verification) ---
USAGE_LOG_PATH=./usage.log.jsonl
